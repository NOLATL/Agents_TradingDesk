[Unit]
Description=Trading desk intraday idea watch (local Qwen only; stages sketches for the nightly scout)

[Timer]
OnCalendar=*-*-* 07,11,15,19:00:00 America/New_York
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
# ln -sf ~/projects/Agents_TradingDesk/ops/trading-desk-intraday.{service,timer} ~/.config/systemd/user/
# systemctl --user daemon-reload && systemctl --user enable --now trading-desk-intraday.timer
